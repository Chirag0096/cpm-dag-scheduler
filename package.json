{
  "name": "cpm-dag-scheduler",
  "version": "1.0.0",
  "description": "Deterministic Backward Critical Path Method (CPM) DAG scheduling and shock-absorber replanning engine in pure TypeScript (<1ms latency, O(V+E))",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx tests/scheduler.test.ts",
    "benchmark": "tsx tests/benchmark.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "cpm",
    "critical-path-method",
    "dag",
    "scheduler",
    "topological-sort",
    "operations-research",
    "replanning",
    "slack-time",
    "float",
    "kitchen-coordination",
    "task-scheduling"
  ],
  "author": "Chirag Aswal <chiragaswal2@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chirag0096/cpm-dag-scheduler.git"
  },
  "bugs": {
    "url": "https://github.com/Chirag0096/cpm-dag-scheduler/issues"
  },
  "homepage": "https://github.com/Chirag0096/cpm-dag-scheduler#readme",
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
